{
  "name": "platter",
  "version": "1.1.0",
  "description": "A music player web app for the music on a (removable) drive. Built for ChromeOS.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "test:all": "npm test && npm run test:rip && npm run test:e2e",
    "icons": "node scripts/make-icons.mjs",
    "scan-dir": "node scripts/scan-dir.mjs",
    "rip": "uv run --project scripts/rip scripts/rip/platter_rip.py",
    "years": "uv run --project scripts/rip scripts/rip/platter_years.py",
    "test:rip": "uv run --project scripts/rip python -m unittest discover -s scripts/rip -p \"test_*.py\"",
    "version": "node scripts/sync-version.mjs && git add app/js/version.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
